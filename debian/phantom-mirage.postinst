#! /bin/sh
# postinst script for phantom-mirage

set -e

# Configurable information
HONEYUSERGROUP="phantom-mirage"
HONEYUSER="phantom-mirage"
# Set to empty if you want it to be set by --system
#HONEYUID=400
HONEYUID=
# Set to empty if you want it to be set by --system
#HONEYGID=400
HONEYGID=
HONEYHOME=/var/log/phantom-mirage
__created_user=0
__created_group=0

# TODO: Consider adding a debconf question if the HONEYUSERGROUP or
# HONEYUSER exist. 

case "$1" in
    configure)
    	if ! getent group | grep -q "^$HONEYUSERGROUP:" ; then
    	  echo -n "Adding group $HONEYUSERGROUP.."
	  if [ -n "$HONEYGID" ] ; then
	  addgroup --quiet --system --gid $HONEYGID $HONEYUSERGROUP
	  else
	  addgroup --quiet --system $HONEYUSERGROUP
	  fi
	  echo "..done"
	  __created_group=1
	fi
    	if ! getent passwd | grep -q "^$HONEYUSER:"; then
    	  echo -n "Adding user $HONEYUSER.."
	  if [ -n "$HONEYUID" ] ; then
	  adduser --quiet --system --home $HONEYHOME \
			--gecos "Phantom Mirage daemon" \
			--disabled-login \
			--disabled-password \
			--no-create-home \
			--ingroup $HONEYUSERGROUP \
			--shell /bin/false \
			--uid $HONEYUID \
			$HONEYUSER
	  else
	  adduser --quiet --system --home $HONEYHOME \
			--gecos "Phantom Mirage daemon" \
			--disabled-login \
			--disabled-password \
			--no-create-home \
			--ingroup $HONEYUSERGROUP \
			--shell /bin/false \
			$HONEYUSER
	  fi
	  echo "..done"
	  __created_user=1
	fi

	# TODO: This should only change ownerships if
	# we have created the user, so we should check if it's 
	# within the range given to admin users...
        HONEYUID=`getent passwd |grep "^$HONEYUSER:" | awk -F : '{print $3}'`
   	HONEYGID=`getent passwd |grep "^$HONEYUSER:" | awk -F : '{print $4}'`
	# Setup the $HONEYHOME directory
	for honeydir in $HONEYHOME ; do
		if [ -d "$honeydir" ] && [ -n "$HONEYUID" ] && \
			[ -n "$HONEYGID" ] ; then
			__currentowner=`stat -c "%U" $honeydir`
			if  [ "$__currentowner" != "$HONEYUSER" ]; then
 	  			echo -n "Granting ownership of $honeydir to $HONEYUSER.."
				chown $HONEYUID:root $honeydir 
			        chmod 0750 $honeydir 
				echo "...done"
			fi
		fi
	done
	# status page graphs + honeyd_traffic.rrd (#16: never in /tmp)
	if [ -d /var/lib/phantom-mirage/graphs ] && [ -n "$HONEYUID" ]; then
		chown -R $HONEYUID:root /var/lib/phantom-mirage/graphs
		chmod 0755 /var/lib/phantom-mirage/graphs
	fi

	# web console (#118): its own unprivileged account, so the
	# attacker-facing daemon can never touch the admin account; it reads
	# the logs through the group (setgid dir, new files inherit it)
	CONUSER=phantom-mirage-console
	if ! getent group "$CONUSER" >/dev/null; then
		addgroup --quiet --system "$CONUSER"
	fi
	if ! getent passwd "$CONUSER" >/dev/null; then
		adduser --quiet --system --home /var/lib/phantom-mirage/console \
			--gecos "Phantom Mirage console" --disabled-login \
			--disabled-password --no-create-home --ingroup "$CONUSER" \
			--shell /usr/sbin/nologin "$CONUSER"
	fi
	if [ -d $HONEYHOME ]; then
		chgrp -R "$CONUSER" $HONEYHOME
		chmod 2750 $HONEYHOME
	fi
	# console state (admin account, certificate, alerts) survives upgrades
	# and purge; only phantom-mirage-uninstall removes it
	mkdir -p /var/lib/phantom-mirage/console
	chown -R "$CONUSER:$CONUSER" /var/lib/phantom-mirage/console
	chown root:"$CONUSER" /var/lib/phantom-mirage/console
	chmod 0770 /var/lib/phantom-mirage/console
	# per decoy settings: the sensor config includes decoys.conf (idempotent,
	# keeps phantom-mirage.conf.pre-decoys.bak the first time)
	if [ -x /usr/lib/phantom-mirage/pm-decoys-include ]; then
		/usr/lib/phantom-mirage/pm-decoys-include || echo "warning: could not add the decoys.conf include" >&2
	fi
	if [ -d /run/systemd/system ]; then
		systemctl daemon-reload >/dev/null 2>&1 || true
		# decoy helper: on an upgrade of a sensor whose console is set up,
		# keep pm-decoyd.socket enabled and listening (no manual step)
		if [ -x /usr/lib/phantom-mirage/pm-decoyd-socket ]; then
			/usr/lib/phantom-mirage/pm-decoyd-socket || true
		fi
		systemctl try-restart phantom-mirage-firewall.service phantom-mirage-console.service >/dev/null 2>&1 || true
	fi

    ;;

    abort-upgrade|abort-remove|abort-deconfigure)

    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

#DEBHELPER#

exit 0
