# Settings for the phantom-mirage service (systemd unit and init script).
# Easiest: run "sudo phantom-mirage-setup", which writes this file for you.
#
# Format: one KEY=VALUE per line; quote values with spaces as a whole
# ("..."), no quotes spanning lines, comments only on their own lines.
# Anything else is refused with a clear message. Check the file with:
#   sudo /usr/lib/phantom-mirage/check-default /etc/default/phantom-mirage

# Master system-wide phantom-mirage switch. The initscript
# will not run if it is not set to yes.
RUN="no"


# Interface Phantom Mirage listens on (required). Use the interface that
# carries the decoy addresses; list the interfaces with:
#   ip -br a
# e.g. INTERFACE="eth0" or INTERFACE="enp0s5". Use only one here; for
# more, add "-i NAME" to OPTIONS. The service refuses to start (and does
# not restart in a loop) while this is empty or names a missing interface.
INTERFACE=""

# Addresses Phantom Mirage answers for (required). Use a SMALL, UNUSED
# block on that interface's LAN, e.g. a /29 (8 addresses):
#   NETWORK=192.168.50.8/29
# Never include addresses used by real hosts (or the gateway): Phantom
# Mirage (and farpd, if you run it for these addresses) would take them
# over. Blocks wider than /24 are refused unless ALLOW_WIDE_NETWORK=yes.
# If NETWORK is empty the service refuses to start; with
# ALLOW_WIDE_NETWORK=yes and NETWORK empty it claims every address it
# sees on INTERFACE (almost never what you want).
NETWORK=""
#ALLOW_WIDE_NETWORK=yes

# You can set some other options here for example:
# Notice that some of the options are already defined in the
# init.d script and must not be used here
# This includes: -f, -l, -p, -x and -a.
# Other options are available.
# This is the default since the webserver uses
# no authentication and could potentially disclose internal
# information (and provide a remote user to edit the phantom-mirage
# configuration).
OPTIONS="--disable-webserver"

# Sandboxing (see docs/sandboxing.md) is on by default: the service
# uses SANDBOX="--sandbox-daemon --sandbox-scripts". To turn it off,
# set SANDBOX here AND set RestrictNamespaces=yes in a unit drop-in
# (systemctl edit phantom-mirage); the unit only relaxes it for these.
#SANDBOX=""
 
# Remove --disable-webserver if you want
# to start up the web server. You will need to ask phantom-mirage
# to fix the permissions of the document root.
# NOTE: You will not be able to manipulate phantom-mirage's configuration
# unless you grant the phantom-mirage user write permission on the 
# configuration files at /etc/phantom-mirage/
#OPTIONS="--fix-webserver-permissions"

