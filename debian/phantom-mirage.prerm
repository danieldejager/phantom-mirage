#!/bin/sh -e 

if [ "$1" != "upgrade" ]; then

	if [ -x "/etc/init.d/phantom-mirage" ] ; then
        	if [ -x "`which invoke-rc.d 2>/dev/null`" ]; then
			invoke-rc.d phantom-mirage stop || exit $?
		else
			/etc/init.d/phantom-mirage stop || exit $?
		fi
	else
                start-stop-daemon --stop --quiet --oknodo --exec /usr/bin/phantom-mirage
	fi
	# console (#118): stop it and remove its nftables table
	if [ -d /run/systemd/system ]; then
		systemctl stop phantom-mirage-console.service phantom-mirage-firewall.service >/dev/null 2>&1 || true
	fi
	if [ -x /usr/lib/phantom-mirage/pm-firewall ]; then
		/usr/lib/phantom-mirage/pm-firewall remove || true
	fi
fi


#DEBHELPER#


exit 0
