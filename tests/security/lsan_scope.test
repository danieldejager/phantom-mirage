# The suppression file hides only the data file loaders: a clean start
# up passes and a leak seeded outside the loaders fails.
cc_daemon lsan_scope tests/security/lsan_scope.c -Wl,--wrap=router_init
ASAN_OPTIONS=detect_leaks=1
export ASAN_OPTIONS
rc=0
run_clean lsan_scope || { echo "clean start up reported" >&2; rc=1; }
if LSAN_SCOPE_SEED=1 run_clean lsan_scope 2>/dev/null; then
	echo "seeded leak was suppressed" >&2; rc=1
elif ! grep -q '__wrap_router_init' "$OUT/lsan_scope.log"; then
	echo "seeded run failed without the seeded leak" >&2; rc=1
fi
[ $rc -eq 0 ]
