#!/bin/sh
# pm-decoys-include: make the sensor config read the per decoy settings
# file written by pm-decoyd. Idempotent; run by the postinst.
#
# Creates /etc/phantom-mirage/decoys.conf (header only) when missing, then
# appends the single line
#   include /etc/phantom-mirage/decoys.conf
# to /etc/phantom-mirage/phantom-mirage.conf when it is not there yet,
# keeping a copy of the old file as phantom-mirage.conf.pre-decoys.bak.
# PM_ETC overrides the directory (tests only).
set -eu

etc=${PM_ETC:-/etc/phantom-mirage}
conf=$etc/phantom-mirage.conf
dec=$etc/decoys.conf
line="include /etc/phantom-mirage/decoys.conf"

[ -f "$conf" ] || { echo "pm-decoys-include: $conf not found, nothing to do"; exit 0; }
if [ -L "$conf" ] || [ -L "$dec" ]; then
	echo "pm-decoys-include: refusing symlinked config" >&2
	exit 1
fi

if [ ! -e "$dec" ]; then
	umask 022
	tmp=$dec.new.$$
	printf '%s\n' "# Generated by pm-decoyd from /var/lib/phantom-mirage/decoys.json." \
		"# Do not edit by hand: every change from the console rewrites this file." > "$tmp"
	mv -f "$tmp" "$dec"
fi

if grep -qxF "$line" "$conf"; then
	exit 0
fi
cp -p "$conf" "$conf.pre-decoys.bak"
tmp=$conf.new.$$
cp -p "$conf" "$tmp"
# make sure the file ends in a newline before appending
[ -z "$(tail -c 1 "$tmp")" ] || echo >> "$tmp"
printf '%s\n' "$line" >> "$tmp"
mv -f "$tmp" "$conf"
echo "pm-decoys-include: added the decoys.conf include to $conf (backup $conf.pre-decoys.bak)"
