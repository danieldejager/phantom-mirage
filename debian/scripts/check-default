#!/bin/sh
# Sanity-check /etc/default/phantom-mirage before the daemon starts (#110).
# Run by the systemd unit (via pm-start) and the init script. On a
# configuration error it prints one clear "phantom-mirage: ..." line on
# stderr (the journal under systemd) and exits 78 (EX_CONFIG); the unit has
# RestartPreventExitStatus=78 so a config error is not retried.
#
# Usage: check-default [DEFAULT_FILE]
# PM_SYSFS_NET overrides /sys/class/net, PM_LIBDIR the library dir (tests).
DEFAULT=${1:-/etc/default/phantom-mirage}
. "${PM_LIBDIR:-/usr/lib/phantom-mirage}/default-lib.sh"
pm_load_default "$DEFAULT"
pm_check "$DEFAULT"
