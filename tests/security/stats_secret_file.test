# PM-SCR-028: stats collector password from a 0600 file, for the daemon
# and the sniffer
cc_daemon stats_secret_file tests/security/stats_secret_file.c \
    -Wl,--wrap=stats_init_collect,--wrap=lstat
# The sniffer: hsniff.c with its main() renamed, no capture device
# shellcheck disable=SC2086
$CC $SAN $CF -Dmain=hsniff_main -c hsniff.c -o "$OUT/obj/hsniff_main.o"
cc_san stats_secret_sniff -DHSNIFF tests/security/stats_secret_file.c \
    "$OUT/obj/hsniff_main.o" tagging.c stats.c util.c hooks.c \
    interface.c pfctl_osfp.c pf_osfp.c osfp.c network.c sha1.c \
    -Wl,--wrap=stats_init_collect,--wrap=lstat \
    -Wl,--wrap=interface_initialize,--wrap=interface_prevent_init
# The run stops in main() before any cleanup: leak checks off
ASAN_OPTIONS=detect_leaks=0
# Random per run so no credential like literal is committed
SECRET=t$(od -An -N8 -tx1 /dev/urandom | tr -d " \n")
export STATS_EXPECT=$SECRET
D=$(mktemp -d "$OUT/stats_secret.XXXXXX")
printf '%s\n' "$SECRET" > "$D/good"
chmod 0600 "$D/good"
cp "$D/good" "$D/open"
chmod 0644 "$D/open"
ln -s "$D/good" "$D/link"
# 1023 and 1024 byte passwords, the limit and one byte over
P1023=$(head -c 1023 /dev/zero | tr '\0' 'p')
printf '%s\n' "$P1023" > "$D/max"
printf '%sp\n' "$P1023" > "$D/over"
chmod 0600 "$D/max" "$D/over"
# A FIFO that the wrapped lstat reports as a 0600 regular file
mkfifo -m 0600 "$D/fifo"
ok=0

# expect PROG NAME RC PATTERN args...: exit code RC, PATTERN in the
# output, the secret never in the output. A hang is killed after 20s.
expect() {
	ep=$1; en=$2; erc=$3; pat=$4; shift 4
	if [ "$ep" = stats_secret_file ]; then
		# Fingerprint files are not read before the stats setup
		set -- -d -x /dev/null -a /dev/null -p /dev/null \
		    -0 /dev/null -m /dev/null "$@"
	else
		set -- -d "$@" 192.0.2.1
	fi
	rc=0
	timeout 20 "$OUT/$ep" "$@" > "$OUT/$ep.$en.log" 2>&1 || rc=$?
	echo "== $ep $en: exit $rc"
	grep -v '^phantom-mirage\[' "$OUT/$ep.$en.log" | \
	    grep -E 'collector|stats password|password|Warning|Usage' | head -3
	if [ "$rc" -ne "$erc" ]; then
		echo "FAIL: $ep $en exit $rc, want $erc"; ok=1
	fi
	if ! grep -q -- "$pat" "$OUT/$ep.$en.log"; then
		echo "FAIL: $ep $en missing: $pat"; ok=1
	fi
	if grep -q -- "$SECRET" "$OUT/$ep.$en.log"; then
		echo "FAIL: $ep $en output contains the secret"; ok=1
	fi
	if grep -Eq 'ERROR: (Address|Leak)Sanitizer|runtime error:' \
	    "$OUT/$ep.$en.log"; then
		echo "FAIL: $ep $en sanitizer report"; ok=1
	fi
}

for prog in stats_secret_file stats_secret_sniff; do
	expect $prog file 0 'collector user alice, password matches' \
	    -c 127.0.0.1:9:alice --stats-password-file "$D/good"
	expect $prog mode0644 1 'mode 0644 is too open' \
	    -c 127.0.0.1:9:alice --stats-password-file "$D/open"
	expect $prog symlink 1 'refusing a symlink' \
	    -c 127.0.0.1:9:alice --stats-password-file "$D/link"
	if [ "$(id -u)" -ne 0 ] && [ -f /etc/shadow ]; then
		expect $prog notowner 1 'not owned by the running user' \
		    -c 127.0.0.1:9:alice --stats-password-file /etc/shadow
	fi
	STATS_EXPECT=$P1023
	expect $prog max1023 0 'collector user alice, password matches' \
	    -c 127.0.0.1:9:alice --stats-password-file "$D/max"
	STATS_EXPECT=$SECRET
	expect $prog over1023 1 'password longer than 1023 bytes' \
	    -c 127.0.0.1:9:alice --stats-password-file "$D/over"
	export STATS_FAKE_REG="$D/fifo"
	expect $prog fifo 1 'not a regular file' \
	    -c 127.0.0.1:9:alice --stats-password-file "$D/fifo"
	unset STATS_FAKE_REG
	expect $prog cli 0 'password in -c is deprecated' \
	    -c "127.0.0.1:9:alice:$SECRET"
	expect $prog cli_works 0 'collector user alice, password matches' \
	    -c "127.0.0.1:9:alice:$SECRET"
	expect $prog cli_argv 0 'password matches, cmdline clean' \
	    -c "127.0.0.1:9:alice:$SECRET"
	expect $prog cli_attached_argv 0 'password matches, cmdline clean' \
	    "-c127.0.0.1:9:alice:$SECRET"
	expect $prog cli_attached 0 \
	    'started with .*-c127.0.0.1:9:alice:\*\*\*\*\*' \
	    "-c127.0.0.1:9:alice:$SECRET"
	expect $prog cli_cluster 0 \
	    'started with .*-Pc 127.0.0.1:9:alice:\*\*\*\*\*' \
	    -Pc "127.0.0.1:9:alice:$SECRET"
done
rm -rf "$D"
[ $ok -eq 0 ]
