# PM-SCR-222: retry of a UDP flow refused at the script cap, case udpretry (see script_cap.c)
cc_daemon script_cap_udpretry tests/security/script_cap.c \
    -Wl,--wrap=setgroups,--wrap=kill,--wrap=killpg,--wrap=sigprocmask
# The daemon's global configuration is never freed: leak checks off
ASAN_OPTIONS=detect_leaks=0
run_clean script_cap_udpretry udpretry
