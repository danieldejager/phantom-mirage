#!/bin/sh
# phantom-mirage-uninstall: remove Phantom Mirage and everything it left
# behind (test boxes). POSIX sh, run as root. Standalone: also shipped
# next to the release .debs.
#
#   sudo phantom-mirage-uninstall [--yes] [--dry-run]
#
# Stops and disables the service, purges phantom-mirage and
# phantom-mirage-common, removes /etc/default/phantom-mirage (and its
# .bak-* copies), /etc/phantom-mirage, /var/lib/phantom-mirage,
# /var/log/phantom-mirage and the phantom-mirage user/group if still
# there, turns promiscuous mode off on the configured interface, and
# prints what it removed. Without --yes it asks first.

main() {
	YES= DRY=
	for a in "$@"; do
		case $a in
			--yes|-y) YES=1 ;;
			--dry-run|-n) DRY=1 ;;
			-h|--help) sed -n '2,13s/^# \{0,1\}//p' "$0"; exit 0 ;;
			*) echo "unknown option: $a" >&2; exit 2 ;;
		esac
	done
	if [ -z "$DRY" ] && [ "$(id -u)" != 0 ]; then
		echo "phantom-mirage-uninstall: must be run as root (or use --dry-run)" >&2; exit 1
	fi

	DEFAULT=/etc/default/phantom-mirage
	IFACE=
	if [ -r "$DEFAULT" ]; then
		IFACE=$(sed -n "s/^[[:space:]]*INTERFACE=[\"']\{0,1\}\([A-Za-z0-9_.:@-]*\).*/\1/p" "$DEFAULT" | tail -n 1)
	fi

	if [ -z "$YES" ] && [ -z "$DRY" ]; then
		printf 'Remove Phantom Mirage, its config, logs and user from this machine? [y/N] '
		read -r ans || ans=
		case $ans in y|Y|yes|YES) ;; *) echo "aborted"; exit 1 ;; esac
	fi

	removed=
	run() {
		if [ -n "$DRY" ]; then echo "would run: $*"; else echo "+ $*"; "$@"; fi
	}
	note() { removed="$removed
  $*"; }

	if command -v systemctl >/dev/null 2>&1 && systemctl cat phantom-mirage.service >/dev/null 2>&1; then
		run systemctl disable --now phantom-mirage.service || true
		note "service phantom-mirage (stopped, disabled)"
	fi
	pkgs=
	for p in phantom-mirage phantom-mirage-common; do
		st=$(dpkg-query -W -f='${db:Status-Abbrev}' "$p" 2>/dev/null || true)
		case $st in ''|un*|pn*) ;; *) pkgs="$pkgs $p" ;; esac
	done
	if [ -n "$pkgs" ]; then
		# shellcheck disable=SC2086
		run env DEBIAN_FRONTEND=noninteractive apt-get purge -y $pkgs
		note "packages:$pkgs (purged)"
	fi
	for d in "$DEFAULT" "$DEFAULT".bak-* "$DEFAULT".new /etc/phantom-mirage /var/lib/phantom-mirage /var/log/phantom-mirage; do
		[ -e "$d" ] || [ -L "$d" ] || continue
		run rm -rf -- "$d"
		note "$d"
	done
	if getent passwd phantom-mirage >/dev/null 2>&1; then
		run userdel phantom-mirage || true
		note "user phantom-mirage"
	fi
	if getent group phantom-mirage >/dev/null 2>&1; then
		run groupdel phantom-mirage || true
		note "group phantom-mirage"
	fi
	if [ -n "$IFACE" ] && [ -e "/sys/class/net/$IFACE" ]; then
		run ip link set dev "$IFACE" promisc off
		note "promiscuous mode on $IFACE (off)"
	fi
	if [ -n "$DRY" ]; then echo "dry run; would remove:${removed:-
  nothing (not installed)}"
	else echo "removed:${removed:-
  nothing (not installed)}"; fi
}
main "$@"
exit $?
