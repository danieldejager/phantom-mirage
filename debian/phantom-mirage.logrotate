/var/log/phantom-mirage/phantom-mirage.log /var/log/phantom-mirage/daemon.log {
  missingok
  notifempty
  monthly
  rotate 3
  compress
}

/var/log/phantom-mirage/events.jsonl {
  su phantom-mirage phantom-mirage-console
  missingok
  notifempty
  weekly
  rotate 4
  compress
  delaycompress
  copytruncate
}
