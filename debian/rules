#!/usr/bin/make -f
# Modern debhelper (compat 13) packaging. Python is opt-in upstream (#36),
# so the binary does not link libpython; the service scripts need python3
# at run time only (Recommends).

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

D = $(CURDIR)/debian/phantom-mirage

%:
	dh $@

override_dh_autoreconf:
	dh_autoreconf ./autogen.sh

override_dh_auto_configure:
	# rrdtool is optional at run time (Recommends); fix its path so the
	# build does not depend on what the build machine has installed
	dh_auto_configure -- --sysconfdir=/etc ac_cv_path_PATH_RRDTOOL=/usr/bin/rrdtool

override_dh_auto_install:
	dh_auto_install --destdir=$(D)
	# Relocate configuration files to /etc/phantom-mirage, keep symlinks
	mkdir -p $(D)/etc/phantom-mirage
	for f in nmap.assoc nmap-mac-prefixes nmap-os-db xprobe2.conf pf.os \
	    columbo-v1.db columbo-v1.db.sha256; do \
	  mv $(D)/usr/share/phantom-mirage/$$f $(D)/etc/phantom-mirage/$$f; \
	  ln -s /etc/phantom-mirage/$$f $(D)/usr/share/phantom-mirage/$$f; \
	done
	# Debian only (#110, #123): default template answers ping and has open
	# TCP ports (the sample's only bind is commented out); see debian/mkconf.sh
	sh debian/mkconf.sh $(D)/usr/share/phantom-mirage/config.sample \
	  $(D)/etc/phantom-mirage/phantom-mirage.conf
	rm -f $(D)/usr/share/phantom-mirage/config.sample
	rm -f $(D)/usr/share/phantom-mirage/README.md
	# graphs and honeyd_traffic.rrd go to a dedicated writable dir (#16)
	mkdir -p $(D)/var/lib/phantom-mirage/graphs
	cp $(D)/usr/share/phantom-mirage/webserver/htdocs/graphs/*.gif $(D)/var/lib/phantom-mirage/graphs/
	rm -rf $(D)/usr/share/phantom-mirage/webserver/htdocs/graphs
	ln -s /var/lib/phantom-mirage/graphs $(D)/usr/share/phantom-mirage/webserver/htdocs/graphs
	find $(D) -name '*.la' -delete
	# /etc/default sanity check run before start (#110)
	install -D -m 0755 debian/scripts/check-default $(D)/usr/lib/phantom-mirage/check-default
	# strict /etc/default reader + start wrapper (#110), setup/uninstall helpers
	install -D -m 0644 debian/scripts/default-lib.sh $(D)/usr/lib/phantom-mirage/default-lib.sh
	install -D -m 0755 debian/scripts/pm-start $(D)/usr/lib/phantom-mirage/pm-start
	install -D -m 0755 debian/scripts/phantom-mirage-setup $(D)/usr/sbin/phantom-mirage-setup
	install -D -m 0755 debian/scripts/phantom-mirage-uninstall $(D)/usr/sbin/phantom-mirage-uninstall
	# AppArmor: "userns" for the --sandbox-scripts launcher only (#16)
	install -D -m 0644 debian/apparmor/usr.lib.phantom-mirage.pm-script-ns \
	  $(D)/etc/apparmor.d/usr.lib.phantom-mirage.pm-script-ns
	install -D -m 0644 debian/apparmor/phantom-mirage-script.abstraction \
	  $(D)/etc/apparmor.d/abstractions/phantom-mirage-script
	dh_apparmor -pphantom-mirage --profile-name=usr.lib.phantom-mirage.pm-script-ns
	# web console (#118): Python 3 standard library only, vendored UI, no CDN
	install -d $(D)/usr/lib/phantom-mirage/console/static
	install -m 0644 console/pmauth.py console/pmstore.py console/branding.py console/branding.conf $(D)/usr/lib/phantom-mirage/console/
	install -m 0755 console/pm-console.py console/pm-console-setup.py $(D)/usr/lib/phantom-mirage/console/
	install -m 0644 console/static/index.html console/static/console.css console/static/console.js console/static/theme.js \
	  docs/assets/phantom-mirage-logo-light.png docs/assets/phantom-mirage-logo-dark.png docs/assets/phantom-mirage-mark.png docs/assets/phantom-mirage-mark-dark.png \
	  docs/assets/phantom-mirage-mark.svg docs/assets/mirage-wordmark.svg $(D)/usr/lib/phantom-mirage/console/static/
	install -D -m 0644 console/static/fonts/Aldrich-Regular.woff2 $(D)/usr/lib/phantom-mirage/console/static/fonts/Aldrich-Regular.woff2
	install -D -m 0644 console/static/fonts/Aldrich-OFL.txt $(D)/usr/lib/phantom-mirage/console/static/fonts/Aldrich-OFL.txt
	install -D -m 0644 debian/brand/logo-24bit.ans $(D)/usr/lib/phantom-mirage/brand/logo-24bit.ans
	install -D -m 0644 debian/brand/logo-256.ans $(D)/usr/lib/phantom-mirage/brand/logo-256.ans
	install -D -m 0755 console/pm-firewall $(D)/usr/lib/phantom-mirage/pm-firewall
	# per decoy settings: root helper behind a unix socket, fixed service list
	install -m 0644 console/decoyclient.py $(D)/usr/lib/phantom-mirage/console/
	install -D -m 0755 decoyd/pm-decoyd.py $(D)/usr/lib/phantom-mirage/pm-decoyd
	install -D -m 0755 debian/scripts/pm-decoys-include $(D)/usr/lib/phantom-mirage/pm-decoys-include
	install -D -m 0644 decoyd/decoy-services.json $(D)/usr/share/phantom-mirage/decoy-services.json

override_dh_installdocs:
	dh_installdocs -pphantom-mirage
	dh_installdocs -pphantom-mirage-common doc/*.html

override_dh_installexamples:
	dh_installexamples -pphantom-mirage debian/config.localhost sample-config/*

override_dh_installinit:
	# runlevels in the LSB header (update-rc.d refuses empty ones, #110) but
	# disabled by default; phantom-mirage-setup enables it
	dh_installinit -pphantom-mirage --no-start --no-stop-on-upgrade --update-rcd-params=defaults-disabled

override_dh_installlogrotate:
	dh_installlogrotate -pphantom-mirage

override_dh_auto_test:
	# Upstream regress/ needs root + veth; covered by the CI jobs.

override_dh_installsystemd:
	dh_installsystemd -pphantom-mirage --no-enable --no-start --no-stop-on-upgrade
	# console + its firewall (#118): enabled by phantom-mirage-setup
	dh_installsystemd -pphantom-mirage --name=phantom-mirage-firewall --no-enable --no-start --no-stop-on-upgrade
	dh_installsystemd -pphantom-mirage --name=phantom-mirage-console --no-enable --no-start --no-stop-on-upgrade
	# per decoy settings helper (socket activated): enabled by phantom-mirage-setup
	dh_installsystemd -pphantom-mirage --name=pm-decoyd --no-enable --no-start --no-stop-on-upgrade
