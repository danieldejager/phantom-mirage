# Drive phantom-mirage-setup the way the one-liner runs: the script is
# piped into sudo, and script(1) is the desktop terminal.
set timeout 40
log_user 1

proc must {pat} {
    global spawn_id timeout
    expect {
        -ex $pat {}
        timeout {
            puts "\nexpect timeout waiting for: $pat\n"
            exit 1
        }
        eof {
            puts "\nsetup exited before: $pat\n"
            exit 1
        }
    }
}

set iface [lindex $argv 0]
set network [lindex $argv 1]
set driver "/tmp/pm-pty-driver.sh"
set f [open $driver w]
puts $f "#!/bin/sh"
puts $f "export PM_SETUP_TRACE=1"
puts $f "exec /usr/sbin/phantom-mirage-setup -i $iface -n $network"
close $f
spawn script -qfec "cat $driver | sudo bash" /dev/null
must "Sensor name (required):"
send "sensor1\r"
must "Admin username:"
send "admin\r"
must "\[8443\]:"
send "\r"
must "\[browser\]:"
send "\r"
must "\[UTC\]:"
send "\r"
must "\[90\]:"
send "\r"
must "Admin password"
send "Ci-console-pass-1\r"
must "Repeat password:"
send "Ci-console-pass-1\r"
must "\[Y/n\]"
send "y\r"
expect {
    eof {}
    timeout {
        puts "\nsetup did not finish\n"
        exit 1
    }
}
catch wait result
set code [lindex $result 3]
if {$code eq ""} {
    exit 1
}
exit $code
