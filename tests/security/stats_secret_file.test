# PM-SCR-028: stats collector password from a 0600 file
cc_daemon stats_secret_file tests/security/stats_secret_file.c \
    -Wl,--wrap=stats_init_collect
# The run stops in main() before any cleanup: leak checks off
ASAN_OPTIONS=detect_leaks=0
# Random per run so no credential like literal is committed
SECRET=t$(od -An -N8 -tx1 /dev/urandom | tr -d " \n")
export STATS_EXPECT=$SECRET
D=$(mktemp -d "$OUT/stats_secret.XXXXXX")
printf '%s\n' "$SECRET" > "$D/good"
chmod 0600 "$D/good"
cp "$D/good" "$D/open"
chmod 0644 "$D/open"
ln -s "$D/good" "$D/link"
ok=0

# expect NAME RC PATTERN args...: exit code RC, PATTERN in the output,
# the secret never in the output
expect() {
	en=$1; erc=$2; pat=$3; shift 3
	rc=0
	# Fingerprint files are not read before the stats setup
	"$OUT/stats_secret_file" -d -x /dev/null -a /dev/null \
	    -p /dev/null -0 /dev/null -m /dev/null "$@" \
	    > "$OUT/stats_secret_file.$en.log" 2>&1 || rc=$?
	echo "== $en: exit $rc"
	grep -v '^phantom-mirage\[' "$OUT/stats_secret_file.$en.log" | \
	    grep -E 'collector|stats password|password|Warning|Usage' | head -3
	if [ "$rc" -ne "$erc" ]; then
		echo "FAIL: $en exit $rc, want $erc"; ok=1
	fi
	if ! grep -q -- "$pat" "$OUT/stats_secret_file.$en.log"; then
		echo "FAIL: $en missing: $pat"; ok=1
	fi
	if grep -q -- "$SECRET" "$OUT/stats_secret_file.$en.log"; then
		echo "FAIL: $en output contains the secret"; ok=1
	fi
	if grep -Eq 'ERROR: (Address|Leak)Sanitizer|runtime error:' \
	    "$OUT/stats_secret_file.$en.log"; then
		echo "FAIL: $en sanitizer report"; ok=1
	fi
}

expect file 0 'collector user alice, password matches' \
    -c 127.0.0.1:9:alice --stats-password-file "$D/good"
expect mode0644 1 'mode 0644 is too open' \
    -c 127.0.0.1:9:alice --stats-password-file "$D/open"
expect symlink 1 'refusing a symlink' \
    -c 127.0.0.1:9:alice --stats-password-file "$D/link"
if [ "$(id -u)" -ne 0 ] && [ -f /etc/shadow ]; then
	expect notowner 1 'not owned by the running user' \
	    -c 127.0.0.1:9:alice --stats-password-file /etc/shadow
fi
expect cli 0 'password in -c is deprecated' \
    -c "127.0.0.1:9:alice:$SECRET"
expect cli_works 0 'collector user alice, password matches' \
    -c "127.0.0.1:9:alice:$SECRET"
expect cli_attached 0 'started with .*-c127.0.0.1:9:alice:\*\*\*\*\*' \
    "-c127.0.0.1:9:alice:$SECRET"
expect cli_cluster 0 'started with .*-Pc 127.0.0.1:9:alice:\*\*\*\*\*' \
    -Pc "127.0.0.1:9:alice:$SECRET"
rm -rf "$D"
[ $ok -eq 0 ]
