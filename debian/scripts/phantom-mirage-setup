#!/bin/sh
# phantom-mirage-setup: write a clean /etc/default/phantom-mirage and start
# the service (#110). POSIX sh, run as root.
#
#   sudo phantom-mirage-setup [--interface IF] [--network CIDR] [--no-farpd] [--dry-run]
#         [--yes] [console options]
#   sudo phantom-mirage-setup --console [console options]   (console only)
#   sudo phantom-mirage-setup --reset-admin                 (terminal only)
#
# Console options (#118): --sensor-name NAME, --admin-user USER,
# --console-port PORT, --time-source ntp|browser, --ntp-server HOST,
# --timezone TZ, --retention DAYS, --reconfigure-console. Anything not
# given is asked; the admin password is only ever asked at a hidden prompt.
#
# Without --interface/--network it keeps those of an existing
# /etc/default/phantom-mirage; otherwise it uses the default-route
# interface and picks a /29 near the top of that interface's IPv4 subnet
# whose 8 addresses do not answer ping/arping and are not in the neighbour
# table. The old file is kept as /etc/default/phantom-mirage.bak-<time>.
# Unless --no-farpd, it also points farpd (if installed) at the same
# INTERFACE/NETWORK so the decoys answer ARP: /etc/default/farpd is
# rewritten (the original kept once as /etc/default/farpd.phantom-mirage-orig,
# which phantom-mirage-uninstall restores) and farpd is enabled/restarted.
#
# Before it enables or starts anything it prints the interface, subnet,
# gateway and /29 it will use (and that farpd claims those 8 addresses on
# the LAN over ARP) and asks [Y/n] on a terminal, on every run. With no
# terminal (the one-line install) it enables and starts the sensor, farpd
# when it is installed, the console firewall, the web console and the
# decoy-helper socket. --yes (-y) does the same when you want to skip the
# question on a terminal, e.g.
#   sudo phantom-mirage-setup --yes -i eth1 -n 10.0.0.248/29
set -eu

DEFAULT=/etc/default/phantom-mirage
LIBDIR=${PM_LIBDIR:-/usr/lib/phantom-mirage}
IFACE= NET= DRY= FARPD=1 YES= CONLY= CON= CONSOLE=$LIBDIR/console/pm-console-setup.py
FDEFAULT=/etc/default/farpd
FMARK='# written by phantom-mirage-setup'
# test-only overrides, honoured only with PM_TESTING=1
if [ "${PM_TESTING:-}" = 1 ]; then
	DEFAULT=${PM_DEFAULT:-$DEFAULT} FDEFAULT=${PM_FDEFAULT:-$FDEFAULT}
fi

usage() { sed -n '2,32s/^# \{0,1\}//p' "$0"; exit "${1:-0}"; }
die() { echo "phantom-mirage-setup: $*" >&2; exit 1; }
say() { echo "phantom-mirage-setup: $*"; }

while [ $# -gt 0 ]; do
	case $1 in
		--interface|-i) [ $# -ge 2 ] || usage 2; IFACE=$2; shift 2 ;;
		--interface=*) IFACE=${1#*=}; shift ;;
		--network|-n) [ $# -ge 2 ] || usage 2; NET=$2; shift 2 ;;
		--network=*) NET=${1#*=}; shift ;;
		--dry-run) DRY=1; CON="$CON
--dry-run"; shift ;;
		--no-farpd) FARPD=; shift ;;
		--yes|-y) YES=1; shift ;;
		--pass*|-p|--pw|--pw=*|--secret*)
			die "the admin password is never accepted as an option; you will be asked for it at a hidden prompt" ;;
		--sensor-name|--admin-user|--console-port|--time-source|--ntp-server|--timezone|--retention)
			[ $# -ge 2 ] || usage 2
			case $2 in *"
"*) die "bad value for $1" ;; esac
			CON="$CON
$1=$2"; shift 2 ;;
		--sensor-name=*|--admin-user=*|--console-port=*|--time-source=*|--ntp-server=*|--timezone=*|--retention=*)
			case $1 in *"
"*) die "bad value" ;; esac
			CON="$CON
$1"; shift ;;
		--reconfigure-console) CON="$CON
--reconfigure"; shift ;;
		--console) CONLY=1; shift ;;
		--reset-admin)
			shift
			[ $# -eq 0 ] || die "--reset-admin takes no other options"
			exec /usr/bin/python3 -I "$CONSOLE" reset-admin ;;
		-h|--help) usage 0 ;;
		*) echo "unknown option: $1" >&2; usage 2 ;;
	esac
done

# ---- splash banner (#141): names from the single branding file; colour
# only on a terminal and without NO_COLOR or TERM=dumb; logo art only in a
# UTF-8 locale, else a plain wordmark
BRANDING=$LIBDIR/console/branding.conf
# PM_BRANDING is a test-only override, honoured only with PM_TESTING=1
[ "${PM_TESTING:-}" = 1 ] && [ -n "${PM_BRANDING:-}" ] && BRANDING=$PM_BRANDING
# strip C0 controls, DEL and UTF-8 encoded C1 controls (ESC included)
_bclean() {
	printf '%s' "$1" | LC_ALL=C tr -d '\000-\037\177' | LC_ALL=C sed "s/$(printf '\302')[$(printf '\200')-$(printf '\237')]//g"
}
# parse branding.conf as data (it is never sourced: this runs as root).
# Only the three known KEY="value" lines; no $ ` \ " in values except the
# one literal ${PM_LEGAL_NAME} in PM_COPYRIGHT, expanded here.
load_branding() {
	PM_PRODUCT= PM_LEGAL_NAME= PM_COPYRIGHT= _seen=
	while IFS= read -r _l || [ -n "$_l" ]; do
		case $_l in ''|'#'*) continue ;; esac
		case $_l in *=*) ;; *) return 1 ;; esac
		_k=${_l%%=*} _r=${_l#*=}
		case $_r in \"*\") _r=${_r#\"} _r=${_r%\"} ;; *) return 1 ;; esac
		case " $_seen " in *" $_k "*) return 1 ;; esac
		_pre=$_r _post=
		if [ "$_k" = PM_COPYRIGHT ]; then
			case $_r in *'${PM_LEGAL_NAME}'*)
				_pre=${_r%%'${PM_LEGAL_NAME}'*} _post=${_r#*'${PM_LEGAL_NAME}'} ;;
			esac
		fi
		case $_pre$_post in *[\"\$\`\\]*) return 1 ;; esac
		case $_k in
			PM_PRODUCT) PM_PRODUCT=$(_bclean "$_r") ;;
			PM_LEGAL_NAME) PM_LEGAL_NAME=$(_bclean "$_r") ;;
			PM_COPYRIGHT)
				if [ "$_pre" = "$_r" ]; then PM_COPYRIGHT=$(_bclean "$_r")
				else PM_COPYRIGHT=$(_bclean "$_pre")$PM_LEGAL_NAME$(_bclean "$_post"); fi ;;
			*) return 1 ;;
		esac
		_seen="$_seen $_k"
	done < "$BRANDING"
	[ -n "$PM_PRODUCT" ] && [ -n "$PM_LEGAL_NAME" ] && [ -n "$PM_COPYRIGHT" ]
}
# pre-rendered half-block logo (tools/render-term-logo.py), installed as
# plain text so no image tooling is needed here
LOGODIR=$LIBDIR/brand
# PM_LOGODIR is a test-only override, honoured only with PM_TESTING=1
[ "${PM_TESTING:-}" = 1 ] && [ -n "${PM_LOGODIR:-}" ] && LOGODIR=$PM_LOGODIR
banner() {
	[ -z "${PM_NO_BANNER:-}" ] && [ -r "$BRANDING" ] || return 0
	load_branding || { echo "phantom-mirage-setup: ignoring malformed $BRANDING" >&2; return 0; }
	_h= _o= _logo=
	if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then
		# lettering grey #8A909A: 24-bit only when COLORTERM says so,
		# otherwise 256-colour 245 (#8A8A8A); the logo file follows suit
		case "${COLORTERM:-}" in
			truecolor|24bit) _h=$(printf '\033[38;2;138;144;154m') _logo=$LOGODIR/logo-24bit.ans ;;
			*) _h=$(printf '\033[38;5;245m') _logo=$LOGODIR/logo-256.ans ;;
		esac
		_o=$(printf '\033[0m')
	fi
	case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
		*UTF-8*|*utf-8*|*UTF8*|*utf8*) _c=$PM_COPYRIGHT ;;
		*) _c=$(printf '%s' "$PM_COPYRIGHT" | sed 's/©/(c)/g') _logo= ;;
	esac
	# colour logo only on a UTF-8 colour terminal; otherwise the plain wordmark
	if [ -n "$_logo" ] && [ -r "$_logo" ]; then
		cat "$_logo"
		printf '%s\n' "$_h$PM_PRODUCT  $PM_LEGAL_NAME$_o" "$_h$_c$_o"
	else
		printf '%s\n' "$_h$PM_PRODUCT$_o" "$_h$PM_LEGAL_NAME$_o" "$_c"
	fi
	echo
}
banner

[ -n "$DRY" ] || [ "$(id -u)" = 0 ] || die "must be run as root (or use --dry-run)"
command -v ip >/dev/null || die "ip(8) not found (apt install iproute2)"

# ---- web console (#118): admin account, certificate, time, firewall
CONSOLE_OK=
console_setup() {
	[ -x /usr/bin/python3 ] && [ -e "$CONSOLE" ] || { say "console: not installed"; return 0; }
	_old_ifs=$IFS
	IFS='
'
	set -f
	# shellcheck disable=SC2086
	set -- $CON
	set +f
	IFS=$_old_ifs
	_rc=0
	/usr/bin/python3 -I "$CONSOLE" first-run "$@" || _rc=$?
	case $_rc in
		0) CONSOLE_OK=1 ;;
		3) say "warning: the web console is NOT set up (no terminal for the password prompt)" ;;
		*) exit "$_rc" ;;
	esac
}
console_start() {
	[ -n "$CONSOLE_OK" ] || return 0
	pm_enable phantom-mirage-firewall
	systemctl restart phantom-mirage-firewall
	pm_enable phantom-mirage-console
	systemctl restart phantom-mirage-console
	# per decoy settings helper: socket only, the helper starts on demand
	systemctl enable --now pm-decoyd.socket || say "warning: could not enable pm-decoyd.socket (per decoy settings stay read only)"
	_port=$(sed -n 's/.*"port":[[:space:]]*\([0-9][0-9]*\).*/\1/p' /var/lib/phantom-mirage/console/console.json 2>/dev/null | head -n 1)
	_port=${_port:-8443}
	say "console: https://127.0.0.1:$_port on this sensor only (firewalled on every other interface)."
	say "console: from your PC run  ssh -L $_port:127.0.0.1:$_port <user>@<this sensor>  then open https://localhost:$_port"
	say "console: to remove Phantom Mirage and all console data run  sudo phantom-mirage-uninstall  (asks first)"
}
sensor_name() {
	sed -n 's/.*"sensor_name":[[:space:]]*"\([A-Za-z0-9._-]*\)".*/\1/p' /var/lib/phantom-mirage/console/console.json 2>/dev/null | head -n 1
}
# enable at boot; a failing "systemctl enable" (e.g. update-rc.d refusing an
# init script with empty runlevels, as farpd 0.2 ships) only warns: the
# native unit is then linked into multi-user.target.wants by hand (#110)
pm_enable() {
	systemctl enable "$1" && return 0
	say "warning: systemctl enable $1 failed; linking its systemd unit directly"
	unit=$(systemctl show -p FragmentPath --value "$1.service" 2>/dev/null || true)
	if [ -n "$unit" ] && [ -e "$unit" ]; then
		mkdir -p /etc/systemd/system/multi-user.target.wants
		ln -sf "$unit" "/etc/systemd/system/multi-user.target.wants/$1.service"
		systemctl daemon-reload || true
	else
		say "warning: $1 is not enabled at boot (start it with: sudo systemctl start $1)"
	fi
	return 0
}

# Ask before enabling or starting anything when a person is at a terminal.
# $1 is the plan already printed. With no terminal, start: that is the
# one-line install, which has nowhere to ask.
confirm_start() {
	if [ -n "$YES" ]; then
		say "--yes given: starting without asking"
		return 0
	fi
	if [ -t 0 ]; then
		printf 'phantom-mirage-setup: %s? [Y/n] ' "$1"
		_a=
		read -r _a || _a=n
		case $_a in ''|y|Y|yes|YES) return 0 ;; esac
		say "not starting anything (answered no); the config is written"
		say "to start it, run on a terminal: sudo phantom-mirage-setup"
		exit 0
	fi
	say "no terminal: enabling and starting without asking"
	return 0
}

console_setup
if [ -n "$CONLY" ]; then
	[ -n "$DRY" ] && exit 0
	[ -n "$CONSOLE_OK" ] && confirm_start "start the phantom-mirage-firewall and phantom-mirage-console services now"
	console_start
	exit 0
fi

# keep the decoy interface/network of an existing setup (upgrades, re-runs)
if [ -z "$IFACE$NET" ] && [ -r "$DEFAULT" ]; then
	_i=$(sed -n 's/^INTERFACE="\{0,1\}\([A-Za-z0-9_.:@-]*\)"\{0,1\}[[:space:]]*$/\1/p' "$DEFAULT" | tail -n 1)
	_n=$(sed -n 's/^NETWORK="\{0,1\}\([0-9./]*\)"\{0,1\}[[:space:]]*$/\1/p' "$DEFAULT" | tail -n 1)
	if [ -n "$_i" ] && [ -n "$_n" ] && [ -e "/sys/class/net/$_i" ]; then
		IFACE=$_i NET=$_n
		say "keeping INTERFACE/NETWORK of the existing $DEFAULT (pass --interface/--network to change)"
	fi
fi

ip2int() {
	_o=$1 _r=0
	for _i in 1 2 3 4; do
		_p=${_o%%.*}; _o=${_o#*.}
		case $_p in ''|*[!0-9]*) die "bad IPv4 address: $1" ;; esac
		[ "$_p" -le 255 ] || die "bad IPv4 address: $1"
		_r=$(( (_r << 8) | _p ))
	done
	echo "$_r"
}
int2ip() { echo "$(( ($1 >> 24) & 255 )).$(( ($1 >> 16) & 255 )).$(( ($1 >> 8) & 255 )).$(( $1 & 255 ))"; }

if [ -z "$IFACE" ]; then
	IFACE=$(ip -4 route show default 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit }}')
	[ -n "$IFACE" ] || die "no default route; pass --interface (list them with: ip -br a)"
fi
[ -e "/sys/class/net/$IFACE" ] || die "interface $IFACE does not exist (list them with: ip -br a)"
say "interface: $IFACE"

# address in use on a LAN? ping, arping (if installed), neighbour table
in_use() {
	ping -c 1 -W 1 -I "$IFACE" "$1" >/dev/null 2>&1 && return 0
	if command -v arping >/dev/null 2>&1; then
		arping -c 1 -w 1 -I "$IFACE" "$1" >/dev/null 2>&1 && return 0
	fi
	ip neigh show to "$1" dev "$IFACE" 2>/dev/null | grep -q lladdr && return 0
	return 1
}

CIDR=$(ip -4 -o addr show dev "$IFACE" scope global 2>/dev/null | awk '{print $4; exit}')
GW=$(ip -4 route show default dev "$IFACE" 2>/dev/null | awk '{print $3; exit}')
if [ -z "$NET" ]; then
	[ -n "$CIDR" ] || die "$IFACE has no IPv4 address; pass --network"
	say "subnet of $IFACE: $CIDR${GW:+, gateway $GW}"
	self=$(ip2int "${CIDR%/*}") plen=${CIDR#*/}
	[ "$plen" -le 28 ] || die "subnet $CIDR is too small for a /29 of decoys; pass --network"
	mask=$(( (0xffffffff << (32 - plen)) & 0xffffffff ))
	net=$(( self & mask )) bcast=$(( (self & mask) | (~mask & 0xffffffff) ))
	gw=-1; [ -n "$GW" ] && gw=$(ip2int "$GW")
	tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
	# skip the /29 holding the broadcast address, then walk down
	base=$(( bcast + 1 - 16 )) tries=0
	while [ "$base" -gt "$net" ] && [ $tries -lt 16 ]; do
		tries=$((tries + 1))
		end=$(( base + 7 ))
		if { [ "$self" -ge "$base" ] && [ "$self" -le "$end" ]; } ||
		   { [ "$gw" -ge "$base" ] && [ "$gw" -le "$end" ]; }; then
			base=$(( base - 8 )); continue
		fi
		say "probing $(int2ip $base)/29 ..."
		rm -f "$tmp"/busy.*
		a=$base
		while [ "$a" -le "$end" ]; do
			( in_use "$(int2ip $a)" && : > "$tmp/busy.$a" ) &
			a=$(( a + 1 ))
		done
		wait
		if ! ls "$tmp"/busy.* >/dev/null 2>&1; then
			NET="$(int2ip $base)/29"; break
		fi
		say "  in use: $(for f in "$tmp"/busy.*; do int2ip "${f##*.}"; done | tr '\n' ' ')"
		base=$(( base - 8 ))
	done
	[ -n "$NET" ] || die "no free /29 found near the top of $CIDR; pass --network"
fi
say "network: $NET"

SID=
_sn=$(sensor_name)
[ -n "$_sn" ] && SID=" --sensor-id=$_sn"
NEW=$(cat <<EOT
# /etc/default/phantom-mirage, written by phantom-mirage-setup on $(date -R)
# One KEY=VALUE per line; quote values that contain spaces. Comments must be
# on their own lines. Check with: /usr/lib/phantom-mirage/check-default
RUN="yes"

# Decoy interface (list: ip -br a)
INTERFACE="$IFACE"

# Small UNUSED block the decoys answer for (wider than /24 needs
# ALLOW_WIDE_NETWORK=yes). Never include real hosts or the gateway.
NETWORK="$NET"

# Extra daemon options; the built-in web server has no authentication (the
# console, phantom-mirage-console, replaces it). The console reads the JSON
# event log.
OPTIONS="--disable-webserver --json-log=/var/log/phantom-mirage/events.jsonl$SID"
EOT
)

# /etc/default/farpd in the farpd package's own format (farpd.service reads
# it with EnvironmentFile=, the init script sources it): one line each.
FNEW=$(cat <<EOT
$FMARK on $(date -R) for phantom-mirage.
# Original: $FDEFAULT.phantom-mirage-orig (restored by phantom-mirage-uninstall).
# Interface where farpd will listen in
INTERFACE="$IFACE"

# Network for which fake arp daemon will answer to (the decoys)
NETWORK="$NET"
EOT
)
farpd_state=
if [ -z "$FARPD" ]; then
	farpd_state="skipped (--no-farpd): the decoys only get traffic routed to this host"
elif [ ! -x /usr/sbin/farpd ]; then
	farpd_state="NOT configured: farpd is not installed, so nothing answers ARP for $NET (sudo apt-get install -y farpd, then run phantom-mirage-setup again)"
	FARPD=
fi

if [ -n "$DRY" ]; then
	say "dry run: would back up $DEFAULT and write:"
	printf '%s\n' "$NEW" | sed 's/^/    /'
	t=$(mktemp); printf '%s\n' "$NEW" > "$t"
	PM_LIBDIR=$LIBDIR "$LIBDIR/check-default" "$t" || { rm -f "$t"; exit 78; }
	rm -f "$t"
	if [ -n "$FARPD" ]; then
		say "dry run: would back up $FDEFAULT (once, to $FDEFAULT.phantom-mirage-orig), write:"
		printf '%s\n' "$FNEW" | sed 's/^/    /'
		say "dry run: would run systemctl enable farpd and systemctl restart farpd"
	fi
	[ -n "$farpd_state" ] && say "farpd: $farpd_state"
	say "dry run: would run $LIBDIR/check-default $DEFAULT, then systemctl enable phantom-mirage and systemctl restart phantom-mirage"
	say "dry run: would enable and restart phantom-mirage-firewall and phantom-mirage-console"
	exit 0
fi

umask 022
if [ -e "$DEFAULT" ]; then
	bak="$DEFAULT.bak-$(date +%Y%m%d-%H%M%S)"
	cp -p "$DEFAULT" "$bak"; say "old file kept as $bak"
fi
printf '%s\n' "$NEW" > "$DEFAULT.new" && mv "$DEFAULT.new" "$DEFAULT"
say "wrote $DEFAULT"
"$LIBDIR/check-default" "$DEFAULT"
echo
say "about to enable and start the sensor with:"
say "  interface: $IFACE"
say "  subnet:    ${CIDR:-unknown (no IPv4 address on $IFACE)}"
say "  gateway:   ${GW:-none on $IFACE}"
say "  decoys:    $NET"
if [ -n "$FARPD" ]; then
	say "  farpd:     will claim the 8 addresses of $NET on the LAN (answers ARP for them on $IFACE)"
else
	say "  farpd:     $farpd_state"
fi
[ -n "$CONSOLE_OK" ] && say "  console:   phantom-mirage-firewall and phantom-mirage-console are started too"
confirm_start "enable and start phantom-mirage${FARPD:+ and farpd} now"
pm_enable phantom-mirage
if ! systemctl restart phantom-mirage; then
	# a bare "Job ... failed" says nothing; show why and what to send us
	echo >&2
	say "error: phantom-mirage did not start. Last 20 journal lines:" >&2
	# control characters (escape sequences included) are stripped: the
	# journal holds text from the network and must not drive the terminal
	{ journalctl -u phantom-mirage --no-pager -n 20 2>&1 || true; } |
		LC_ALL=C tr -d '\000-\010\013-\037\177' |
		LC_ALL=C sed "s/$(printf '\302')[$(printf '\200')-$(printf '\237')]//g" >&2
	echo >&2
	say "please send the lines above when you report this problem." >&2
	say "after fixing the cause, run: sudo systemctl restart phantom-mirage" >&2
	say "or check the config with: sudo /usr/lib/phantom-mirage/pm-start verify" >&2
	exit 1
fi
if [ -n "$FARPD" ]; then
	if [ -e "$FDEFAULT" ] && ! grep -q "^$FMARK" "$FDEFAULT" && [ ! -e "$FDEFAULT.phantom-mirage-orig" ]; then
		cp -p "$FDEFAULT" "$FDEFAULT.phantom-mirage-orig"
		say "original farpd config kept as $FDEFAULT.phantom-mirage-orig"
	fi
	printf '%s\n' "$FNEW" > "$FDEFAULT.new" && mv "$FDEFAULT.new" "$FDEFAULT"
	say "wrote $FDEFAULT (farpd answers ARP for $NET on $IFACE)"
	pm_enable farpd
	systemctl restart farpd
	farpd_state="answering ARP for $NET on $IFACE"
fi
console_start
sleep 2
systemctl --no-pager --lines=10 status phantom-mirage || true
systemctl --no-pager --lines=5 status farpd 2>/dev/null || true
first=${NET%/*}
say "farpd: $farpd_state"
echo
if grep -q '^[[:space:]]*set default default icmp action open' /etc/phantom-mirage/phantom-mirage.conf 2>/dev/null && [ -n "$FARPD" ]; then
	echo "Test: from another machine on this LAN run 'ping -c3 $first' (logs: journalctl -u phantom-mirage -f)"
else
	echo "Test: from another machine on this LAN run 'nmap -Pn -p 22,80 $first' (logs: journalctl -u phantom-mirage -f)"
fi
