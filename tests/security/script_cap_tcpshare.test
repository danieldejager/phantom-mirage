# PM-SCR-234: real TCP sources cannot take the UDP script share, case tcpshare (see script_cap.c)
cc_daemon script_cap_tcpshare tests/security/script_cap.c \
    -Wl,--wrap=setgroups,--wrap=kill,--wrap=killpg,--wrap=sigprocmask
# The daemon's global configuration is never freed: leak checks off
ASAN_OPTIONS=detect_leaks=0
run_clean script_cap_tcpshare tcpshare
