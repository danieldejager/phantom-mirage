[Unit]
Description=Phantom Mirage virtual honeypot daemon
Documentation=man:phantom-mirage(8)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Same settings as the SysV script. INTERFACE, NETWORK and OPTIONS come
# from /etc/default/phantom-mirage (RUN= is ignored; enable the unit instead).
EnvironmentFile=-/etc/default/phantom-mirage
# phantom-mirage starts as root to open pcap/raw sockets, then drops to the
# phantom-mirage user itself (-u/-g take numeric IDs, hence the shell).
ExecStartPre=/bin/sh -c 'exec /usr/bin/phantom-mirage --verify-config -f /etc/phantom-mirage/phantom-mirage.conf $${INTERFACE:+-i $$INTERFACE} $OPTIONS $NETWORK'
ExecStart=/bin/sh -c 'exec /usr/bin/phantom-mirage -d -f /etc/phantom-mirage/phantom-mirage.conf -l /var/log/phantom-mirage/phantom-mirage.log -p /etc/phantom-mirage/nmap-os-db -a /etc/phantom-mirage/nmap.assoc -0 /etc/phantom-mirage/pf.os -x /etc/phantom-mirage/xprobe2.conf -m /etc/phantom-mirage/nmap-mac-prefixes -u $$(id -u phantom-mirage) -g $$(id -g phantom-mirage) $${INTERFACE:+-i $$INTERFACE} $OPTIONS $NETWORK'
# Optional (#16): confine the daemon, and everything it starts, to a
# seccomp syscall allowlist after its privilege drop. Add
# --sandbox-daemon (and optionally --sandbox-scripts) to OPTIONS in
# /etc/default/phantom-mirage. It is the only syscall filter here (this unit sets
# no SystemCallFilter) and works with NoNewPrivileges and
# ProtectSystem=strict below; a denied call is logged as
# "sandbox-daemon: denied syscall N" and stops phantom-mirage with SIGSYS
# (Restart=on-failure brings it back). See docs/sandboxing.md.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure

# Only what phantom-mirage needs before its own privilege drop (same set as the
# Docker image: raw sockets, interface/ARP setup, setuid/setgid).
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_SETUID CAP_SETGID
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
# /run/phantom-mirage (RuntimeDirectory, root 0700): control socket and
# pid file. The daemon empties the pid file on exit (it can't unlink it
# after the privilege drop); systemd removes the directory on stop.
PIDFile=/run/phantom-mirage/phantom-mirage.pid
ReadWritePaths=/var/log/phantom-mirage /run
RuntimeDirectory=phantom-mirage
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_PACKET AF_NETLINK
UMask=0027

[Install]
WantedBy=multi-user.target
