# PM-SCR-213, PM-SCR-214, PM-SCR-231: loading a duplicate fingerprint or
# association, or a fingerprint line that repeats a field, leaks nothing.
# LeakSanitizer runs with no suppressions.
cc_daemon leak_loaders tests/security/leak_loaders.c
ASAN_OPTIONS=${ASAN_OPTIONS:+$ASAN_OPTIONS:}detect_leaks=1
LSAN_OPTIONS=print_suppressions=0
export ASAN_OPTIONS LSAN_OPTIONS
rc=0
for c in personality assoc dupfield; do
	run_clean leak_loaders "$c" || { echo "case $c failed" >&2; rc=1; }
	cp "$OUT/leak_loaders.log" "$OUT/leak_loaders.$c.log"
done
[ $rc -eq 0 ]
