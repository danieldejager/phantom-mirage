[Unit]
Description=Phantom Mirage virtual honeypot daemon
Documentation=man:phantom-mirage(8)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# INTERFACE, NETWORK, OPTIONS and SANDBOX come from
# /etc/default/phantom-mirage (RUN= is ignored; enable the unit instead).
# The file is read by pm-start, NOT with EnvironmentFile=: systemd lets a
# quoted value span lines, so one stray quote made NETWORK swallow the
# comments below it (#110). pm-start accepts one KEY=VALUE per line only.
# Sandboxing is on by default (#16): pm-start uses
# SANDBOX="--sandbox-daemon --sandbox-scripts" unless /etc/default/phantom-mirage
# (or Environment=SANDBOX= in a drop-in) sets it; see RestrictNamespaces= below.
# Config check (#110): a bad line, a missing/unknown INTERFACE or a
# missing/too-wide NETWORK is logged as one "phantom-mirage: ..." line and
# exits 78 (EX_CONFIG); RestartPreventExitStatus=78 stops the restart loop.
# phantom-mirage starts as root to open pcap/raw sockets, then drops to the
# phantom-mirage user itself (pm-start passes its numeric -u/-g).
ExecStartPre=/usr/lib/phantom-mirage/pm-start check
ExecStartPre=/usr/lib/phantom-mirage/pm-start verify
ExecStart=/usr/lib/phantom-mirage/pm-start run
# Sandboxing (#16), on by default through SANDBOX above:
# --sandbox-daemon confines the daemon, and everything it starts, to a
# seccomp syscall allowlist and Landlock after its privilege drop. It is
# the only syscall filter here (this unit sets no SystemCallFilter) and
# works with NoNewPrivileges and ProtectSystem=strict below; a denied call
# is logged as "sandbox-daemon: denied syscall N" and stops phantom-mirage
# with SIGSYS (Restart=on-failure brings it back). --sandbox-scripts runs
# each service script in its own user/mount/PID/IPC/UTS/network
# namespaces with a private /tmp. If either is missing, phantom-mirage
# logs a warning at start. See docs/sandboxing.md.
# "+": the daemon runs as phantom-mirage and the bounding set below has
# no CAP_KILL, so a sandboxed root kill(1) would get EPERM
ExecReload=+/bin/kill -HUP $MAINPID
Restart=on-failure
RestartPreventExitStatus=78

# Only what phantom-mirage needs before its own privilege drop (same set as the
# Docker image: raw sockets, interface/ARP setup, setuid/setgid).
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_SETUID CAP_SETGID
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
# /run/phantom-mirage (RuntimeDirectory, root 0700): control socket and
# pid file. The daemon empties the pid file on exit (it can't unlink it
# after the privilege drop); systemd removes the directory on stop.
PIDFile=/run/phantom-mirage/phantom-mirage.pid
ReadWritePaths=/var/log/phantom-mirage /var/lib/phantom-mirage/graphs /run
RuntimeDirectory=phantom-mirage
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Relaxed for --sandbox-scripts, whose launcher creates per-script
# namespaces. This is only safe with --sandbox-daemon on: its seccomp
# allowlist keeps unshare/setns away from the daemon itself. If you remove
# --sandbox-daemon (or --sandbox-scripts) from SANDBOX, set
# RestrictNamespaces=yes back in a drop-in (systemctl edit phantom-mirage).
RestrictNamespaces=user mnt pid ipc uts net
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_PACKET AF_NETLINK
UMask=0027

[Install]
WantedBy=multi-user.target
