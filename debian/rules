#!/usr/bin/make -f
# Modern debhelper (compat 13) packaging. Python is opt-in upstream (#36),
# so the binary does not link libpython; the service scripts need python3
# at run time only (Recommends).

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

D = $(CURDIR)/debian/honeyd

%:
	dh $@

override_dh_autoreconf:
	dh_autoreconf ./autogen.sh

override_dh_auto_configure:
	dh_auto_configure -- --sysconfdir=/etc

override_dh_auto_install:
	dh_auto_install --destdir=$(D)
	# Relocate configuration files to /etc/honeypot, keep symlinks
	mkdir -p $(D)/etc/honeypot
	for f in nmap.assoc nmap-mac-prefixes nmap-os-db xprobe2.conf pf.os; do \
	  mv $(D)/usr/share/honeyd/$$f $(D)/etc/honeypot/$$f; \
	  ln -s /etc/honeypot/$$f $(D)/usr/share/honeyd/$$f; \
	done
	mv $(D)/usr/share/honeyd/config.sample $(D)/etc/honeypot/honeyd.conf
	rm -f $(D)/usr/share/honeyd/README
	find $(D) -name '*.la' -delete

override_dh_installdocs:
	dh_installdocs -phoneyd
	dh_installdocs -phoneyd-common doc/*.html

override_dh_installexamples:
	dh_installexamples -phoneyd debian/config.localhost sample-config/*

override_dh_installinit:
	dh_installinit -phoneyd --no-start --no-stop-on-upgrade

override_dh_installlogrotate:
	dh_installlogrotate -phoneyd

override_dh_auto_test:
	# Upstream regress/ needs root + veth; covered by the CI jobs.

override_dh_installsystemd:
	dh_installsystemd -phoneyd --no-enable --no-start --no-stop-on-upgrade
